{
  "name": "core-kit",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm -ws run typecheck",
    "build": "npm -ws run build",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.9.3",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2"
  }
}
