  atualizado_em         DateTime               @default(now()) @db.Timestamptz(6)
  locatarios            locatarios             @relation(fields: [locatario_id], references: [locatario_id], onDelete: Cascade, map: "importacoes_locatarios_fk")
  usuarios              usuarios?              @relation(fields: [criado_por_usuario_id], references: [usuario_id], onDelete: Cascade, map: "importacoes_usuarios_fk")
  itens_importacao      itens_importacao[]

  @@id([importacao_id, locatario_id], map: "importacoes_pk")
  @@schema("jobs")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model itens_importacao {
  item_id       String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
