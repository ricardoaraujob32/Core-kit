  atualizado_em         DateTime           @default(now()) @db.Timestamptz(6)
  locatarios            locatarios         @relation(fields: [locatario_id], references: [locatario_id], onDelete: Cascade, map: "exportacoes_locatarios_fk")
  usuarios              usuarios?          @relation(fields: [criado_por_usuario_id], references: [usuario_id], onDelete: Cascade, map: "exportacoes_usuarios_fk")

