  tokens                                                      tokens[]
  usuarios_usuarios_atualizado_por_usuario_idTousuarios       usuarios?              @relation("usuarios_atualizado_por_usuario_idTousuarios", fields: [atualizado_por_usuario_id], references: [usuario_id], map: "fk_usuarios_atualizado_por_usuario")
  other_usuarios_usuarios_atualizado_por_usuario_idTousuarios usuarios[]             @relation("usuarios_atualizado_por_usuario_idTousuarios")
  usuarios_usuarios_criado_por_usuario_idTousuarios           usuarios?              @relation("usuarios_criado_por_usuario_idTousuarios", fields: [criado_por_usuario_id], references: [usuario_id], map: "fk_usuarios_criado_por_usuario")
  other_usuarios_usuarios_criado_por_usuario_idTousuarios     usuarios[]             @relation("usuarios_criado_por_usuario_idTousuarios")
  usuarios_usuarios_excluido_por_usuario_idTousuarios         usuarios?              @relation("usuarios_excluido_por_usuario_idTousuarios", fields: [excluido_por_usuario_id], references: [usuario_id], map: "fk_usuarios_excluido_por_usuario")
  other_usuarios_usuarios_excluido_por_usuario_idTousuarios   usuarios[]             @relation("usuarios_excluido_por_usuario_idTousuarios")
  locatarios                                                  locatarios?            @relation(fields: [locatario_id], references: [locatario_id], map: "fk_usuarios_locatarios")
  usuarios_papeis                                             usuarios_papeis[]
  usuarios_plataforma                                         usuarios_plataforma[]
  exportacoes                                                 exportacoes[]
  importacoes                                                 importacoes[]

