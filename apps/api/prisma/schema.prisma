generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["api", "audit", "core", "jobs"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auditoria_locatario {
  auditoria_id   String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locatario_id   String     @db.Uuid
  usuario_id     String     @db.Uuid
  evento         String
  sucesso        Boolean
  erro_codigo    String?
  erro_mensagem  String?
  entidade_nome  String?
  entidade_tipo  String?
  entidade_id    String?
  origem         String?
  requisicao_id  String?
  endereco_ip    String?    @db.Inet
  agente_usuario String?
  agente_tipo    String?
  metadados      Json       @default("{}")
  criado_em      DateTime   @default(now()) @db.Timestamptz(6)
  locatarios     locatarios @relation(fields: [locatario_id], references: [locatario_id], onDelete: Cascade, map: "auditoria_locatario_locatarios_fk")
  usuarios       usuarios   @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, map: "auditoria_locatario_usuarios_fk")

  @@id([auditoria_id, locatario_id, usuario_id], map: "auditoria_locatario_pk")
  @@schema("audit")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auditoria_plataforma {
  auditoria_id      String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id        String      @db.Uuid
  locatario_alvo_id String?     @db.Uuid
  evento            String
  sucesso           Boolean
  erro_codigo       String?
  erro_mensagem     String?
  entidade_nome     String?
  entidade_tipo     String?
  entidade_id       String?
  origem            String?
  requisicao_id     String?
  endereco_ip       String?     @db.Inet
  agente_usuario    String?
  agente_tipo       String?
  metadados         Json        @default("{}")
  criado_em         DateTime    @default(now()) @db.Timestamptz(6)
  locatarios        locatarios? @relation(fields: [locatario_alvo_id], references: [locatario_id], map: "auditoria_plataforma_locatarios_fk")
  usuarios          usuarios    @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, map: "auditoria_plataforma_usuarios_fk")

  @@id([auditoria_id, usuario_id], map: "auditoria_plataforma_pk")
  @@schema("audit")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model assinaturas {
  assinatura_id         String               @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locatario_id          String               @db.Uuid
  plano_id              String               @db.Uuid
  status                String               @default("ATIVA")
  inicio_em             DateTime             @default(now()) @db.Timestamptz(6)
  fim_em                DateTime?            @db.Timestamptz(6)
  renovacao_em          DateTime?            @db.Timestamptz(6)
  motivo                String?
  moeda                 String               @default("BRL")
  valor_centavos        Int                  @default(0)
  ciclo                 String               @default("MENSAL")
  proximo_vencimento_em DateTime?            @db.Timestamptz(6)
  ultimo_pagamento_em   DateTime?            @db.Timestamptz(6)
  falha_pagamento_em    DateTime?            @db.Timestamptz(6)
  criado_em             DateTime             @default(now()) @db.Timestamptz(6)
  atualizado_em         DateTime             @default(now()) @db.Timestamptz(6)
  excluido_em           DateTime?            @db.Timestamptz(6)
  locatarios            locatarios           @relation(fields: [locatario_id], references: [locatario_id], onDelete: Cascade, map: "assinaturas_locatarios_fk")
  planos                planos               @relation(fields: [plano_id], references: [id], onDelete: Cascade, map: "assinaturas_planos_fk")
  modulos_assinatura    modulos_assinatura[]

  @@id([assinatura_id, locatario_id], map: "assinaturas_pk")
  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model configuracoes_locatario {
  locatario_id      String     @db.Uuid
  configuracao_id   String     @db.Uuid
  modo_tema         String     @default("SISTEMA")
  identidade_visual String     @unique
  cor_primaria      String?
  cor_secundaria    String?
  cor_terciaria     String?
  url_logo          String?
  ativa             Boolean    @default(false)
  criado_em         DateTime   @default(now()) @db.Timestamptz(6)
  atualizado_em     DateTime   @default(now()) @db.Timestamptz(6)
  locatarios        locatarios @relation(fields: [locatario_id], references: [locatario_id], onDelete: Cascade, map: "configuracoes_locatario_locatarios_fk")

  @@id([locatario_id, configuracao_id], map: "configuracoes_locatario_pk")
  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model locatarios {
  locatario_id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                    String
  slug                    String
  documento               String?
  email                   String
  fuso_horario            String                    @default("America/Sao_Paulo")
  status                  status_locatario          @default(ATIVO)
  excluido_em             DateTime?                 @db.Timestamptz(6)
  motivo_exclusao         String?
  suspenso_em             DateTime?                 @db.Timestamptz(6)
  motivo_suspensao        String?
  reativado_em            DateTime?                 @db.Timestamptz(6)
  motivo_reativacao       String?
  criado_em               DateTime                  @default(now()) @db.Timestamptz(6)
  atualizado_em           DateTime                  @default(now()) @db.Timestamptz(6)
  auditoria_locatario     auditoria_locatario[]
  auditoria_plataforma    auditoria_plataforma[]
  assinaturas             assinaturas[]
  configuracoes_locatario configuracoes_locatario[]
  tokens                  tokens[]
  usuarios                usuarios[]
  usuarios_papeis         usuarios_papeis[]
  exportacoes             exportacoes[]
  importacoes             importacoes[]

  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model modulos {
  modulo_id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo             String               @unique
  nome               String
  categoria          String
  ativo              Boolean              @default(true)
  gratuito           Boolean              @default(false)
  ordem_exibicao     Int                  @default(0)
  criado_em          DateTime             @default(now()) @db.Timestamptz(6)
  atualizado_em      DateTime             @default(now()) @db.Timestamptz(6)
  modulos_assinatura modulos_assinatura[]

  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model modulos_assinatura {
  locatario_id  String      @db.Uuid
  modulo_id     String      @db.Uuid
  habilitado    Boolean     @default(true)
  origem        String      @default("PLANO")
  criado_em     DateTime    @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime    @default(now()) @db.Timestamptz(6)
  assinatura_id String      @db.Uuid
  assinaturas   assinaturas @relation(fields: [assinatura_id, locatario_id], references: [assinatura_id, locatario_id], onDelete: Cascade, map: "modulos_assinatura_assinaturas_fk")
  modulos       modulos     @relation(fields: [modulo_id], references: [modulo_id], onDelete: Cascade, map: "modulos_assinatura_modulos_fk")

  @@id([locatario_id, assinatura_id, modulo_id], map: "modulos_assinatura_pk")
  @@schema("core")
}

model papeis {
  papel_id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo              String                @unique
  nome                String
  descricao           String?
  criado_em           DateTime              @default(now()) @db.Timestamptz(6)
  atualizado_em       DateTime              @default(now()) @db.Timestamptz(6)
  papel_permissoes    papel_permissoes[]
  usuarios_papeis     usuarios_papeis[]
  usuarios_plataforma usuarios_plataforma[]

  @@schema("core")
}

model papel_permissoes {
  papel_id      String     @db.Uuid
  permissao_id  String     @db.Uuid
  criado_em     DateTime   @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime   @default(now()) @db.Timestamptz(6)
  papeis        papeis     @relation(fields: [papel_id], references: [papel_id], onDelete: Cascade, map: "fk_papel_permissoes_papeis")
  permissoes    permissoes @relation(fields: [permissao_id], references: [permissao_id], onDelete: Cascade, map: "fk_papel_permissoes_permissoes")

  @@id([papel_id, permissao_id], map: "pk_papel_permissoes")
  @@schema("core")
}

model permissoes {
  permissao_id     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo           String             @unique
  nome             String
  descricao        String?
  criado_em        DateTime           @default(now()) @db.Timestamptz(6)
  atualizado_em    DateTime           @default(now()) @db.Timestamptz(6)
  papel_permissoes papel_permissoes[]

  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model planos {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo        String        @unique
  nome          String
  ativo         Boolean       @default(true)
  criado_em     DateTime      @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime      @default(now()) @db.Timestamptz(6)
  assinaturas   assinaturas[]

  @@schema("core")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tokens {
  token_id           String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id         String      @db.Uuid
  locatario_id       String?     @db.Uuid
  hash_token         String      @unique
  emitido_em         DateTime    @default(now()) @db.Timestamptz(6)
  expira_em          DateTime    @db.Timestamptz(6)
  revogado_em        DateTime?   @db.Timestamptz(6)
  proximo_token_id   String?     @db.Uuid
  proximo_usuario_id String?     @db.Uuid
  agente_usuario     String?
  endereco_ip        String?     @db.Inet
  tipo               tipo_token?
  tokens             tokens?     @relation("tokensTotokens", fields: [proximo_token_id, proximo_usuario_id], references: [token_id, usuario_id], map: "fk_proximo_token_id")
  other_tokens       tokens[]    @relation("tokensTotokens")
  usuarios           usuarios    @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, map: "fk_tokens_usuarios")
  locatarios         locatarios? @relation(fields: [locatario_id], references: [locatario_id], map: "tokens_locatarios_fk")

  @@id([token_id, usuario_id], map: "pk_token")
  @@schema("core")
}

