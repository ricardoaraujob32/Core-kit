generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["api", "audit", "core", "jobs"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auditoria_locatario {
  auditoria_id   String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locatario_id   String     @db.Uuid
  usuario_id     String     @db.Uuid
  evento         String
  sucesso        Boolean
  erro_codigo    String?
  erro_mensagem  String?
  entidade_nome  String?
  entidade_tipo  String?
  entidade_id    String?
  origem         String?
  requisicao_id  String?
  endereco_ip    String?    @db.Inet
  agente_usuario String?
  agente_tipo    String?
  metadados      Json       @default("{}")
  criado_em      DateTime   @default(now()) @db.Timestamptz(6)
  locatarios     locatarios @relation(fields: [locatario_id], references: [locatario_id], map: "auditoria_locatario_locatarios_fk")
  usuarios       usuarios   @relation(fields: [locatario_id, usuario_id], references: [locatario_id, usuario_id], map: "auditoria_locatario_usuarios_fk")

  @@id([auditoria_id, locatario_id], map: "auditoria_locatario_pk")
  @@schema("audit")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auditoria_plataforma {
  auditoria_id      String              @id(map: "auditoria_plataforma_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id        String              @db.Uuid
  locatario_alvo_id String?             @db.Uuid
  evento            String
  sucesso           Boolean
  erro_codigo       String?
  erro_mensagem     String?
  entidade_nome     String?
  entidade_tipo     String?
  entidade_id       String?
  origem            String?
  requisicao_id     String?
  endereco_ip       String?             @db.Inet
  agente_usuario    String?
  agente_tipo       String?
  metadados         Json                @default("{}")
  criado_em         DateTime            @default(now()) @db.Timestamptz(6)
  locatarios        locatarios?         @relation(fields: [locatario_alvo_id], references: [locatario_id], map: "auditoria_plataforma_locatarios_fk")
  usuarios_temp     usuarios_plataforma @relation(fields: [usuario_id], references: [usuario_id], map: "auditoria_plataforma_usuarios_fk")

  @@schema("audit")
}

