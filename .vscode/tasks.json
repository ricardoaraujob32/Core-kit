{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "tsProject",
      "type": "pickString",
      "description": "Projeto ou pacote TypeScript",
      "options": [
        "packages/core/tsconfig.json",
        "apps/api/tsconfig.json",
        "apps/web/tsconfig.json"
      ],
      "default": "apps/api/tsconfig.json"
    },
    {
      "id": "tsDebugFile",
      "type": "promptString",
      "description": "Arquivo TypeScript para validar rapidamente",
      "default": "apps/api/src/server.ts"
    }
  ],
  "tasks": [
    {
      "label": "TS: Compilar tudo",
      "type": "shell",
      "command": "npx tsc -b packages/core/tsconfig.json apps/api/tsconfig.json apps/web/tsconfig.json",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "TS: So validar tipos",
      "type": "shell",
      "command": "npx tsc --noEmit -p packages/core/tsconfig.json && npx tsc --noEmit -p apps/api/tsconfig.json && npx tsc --noEmit -p apps/web/tsconfig.json",
      "group": "test",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "TS: Compilar projeto individual",
      "type": "shell",
      "command": "npx tsc -p ${input:tsProject}",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "TS: Revisar projeto individual",
      "type": "shell",
      "command": "npx tsc --noEmit -p ${input:tsProject}",
      "group": "test",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "TS: Debug rapido",
      "type": "shell",
      "command": "npx tsc --noEmit ${input:tsDebugFile}",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "TS: Auto recompilar",
      "type": "shell",
      "command": "npx tsc -w -p ${input:tsProject}",
      "isBackground": true,
      "problemMatcher": [
        "$tsc-watch"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "TS: Limpar build",
      "type": "shell",
      "command": "npx tsc -b packages/core/tsconfig.json apps/api/tsconfig.json apps/web/tsconfig.json --clean",
      "problemMatcher": []
    },
    {
      "label": "TS: Limpar projeto individual",
      "type": "shell",
      "command": "npx tsc -b ${input:tsProject} --clean",
      "problemMatcher": []
    },
    {
      "label": "Backend: Iniciar",
      "type": "shell",
      "command": "node --env-file=apps/api/.env --import tsx apps/api/src/server.ts",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Server listening at http://"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Backend: Desligar",
      "type": "shell",
      "command": "bash -lc \"pids=$(lsof -tiTCP:3333 -sTCP:LISTEN 2>/dev/null); if [ -n \\\"$pids\\\" ]; then kill $pids; else pkill -f 'apps/api/src/server.ts|dist/cli.mjs apps/api/src/server.ts' || true; fi\"",
      "problemMatcher": []
    },
    {
      "label": "Backend: Reiniciar",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Backend: Desligar",
        "Backend: Iniciar"
      ],
      "problemMatcher": []
    },
    {
      "label": "Frontend: Iniciar",
      "type": "shell",
      "command": "pnpm -C apps/web dev -- --host 0.0.0.0",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Frontend: Desligar",
      "type": "shell",
      "command": "bash -lc \"pids=$(lsof -tiTCP:5173 -sTCP:LISTEN 2>/dev/null); if [ -n \\\"$pids\\\" ]; then kill $pids; else pkill -f 'vite.*--host 0.0.0.0|pnpm -C apps/web dev' || true; fi\"",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Reiniciar",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Frontend: Desligar",
        "Frontend: Iniciar"
      ],
      "problemMatcher": []
    },
    {
      "label": "Core: Build",
      "type": "shell",
      "command": "npx tsc -p packages/core/tsconfig.json",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "API: Build",
      "type": "shell",
      "command": "npx tsc -p apps/api/tsconfig.json",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Frontend: Build",
      "type": "shell",
      "command": "npx tsc -p apps/web/tsconfig.json",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Root: Testes Unitarios",
      "type": "shell",
      "command": "pnpm test:unit",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Core: Testes",
      "type": "shell",
      "command": "pnpm -C packages/core vitest run",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "API: Testes",
      "type": "shell",
      "command": "pnpm -C apps/api vitest run",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Testes Unitarios",
      "type": "shell",
      "command": "echo \"Sem testes unitarios configurados em apps/web\"",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
