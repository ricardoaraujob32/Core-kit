{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "tsProject",
      "type": "pickString",
      "description": "Projeto ou pacote TypeScript",
      "options": [
        "packages/core/tsconfig.json",
        "apps/api/tsconfig.json",
        "apps/web/tsconfig.json"
      ],
      "default": "apps/api/tsconfig.json"
    },
    {
      "id": "tsDebugFile",
      "type": "promptString",
      "description": "Arquivo TypeScript para validar rapidamente",
      "default": "apps/api/src/server.ts"
    }
  ],
  "tasks": [
    {
      "label": "TS: Compilar tudo",
      "type": "shell",
      "command": "pnpm -C packages/core build && pnpm -C apps/api build && pnpm -C apps/web build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "TS: So validar tipos",
      "type": "shell",
      "command": "pnpm -C packages/core typecheck && pnpm -C apps/api typecheck && pnpm -C apps/web typecheck",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "TS: Compilar projeto individual",
      "type": "shell",
      "command": "npx tsc -p ${input:tsProject}",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "TS: Revisar projeto individual",
      "type": "shell",
      "command": "npx tsc --noEmit -p ${input:tsProject}",
      "group": "test",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "TS: Debug rapido",
      "type": "shell",
      "command": "npx tsc --noEmit ${input:tsDebugFile}",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "TS: Auto recompilar",
      "type": "shell",
      "command": "npx tsc -w -p ${input:tsProject}",
      "isBackground": true,
      "problemMatcher": [
        "$tsc-watch"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "TS: Limpar build",
      "type": "shell",
      "command": "npx tsc -b packages/core/tsconfig.json apps/api/tsconfig.json apps/web/tsconfig.json --clean",
      "problemMatcher": []
    },
    {
      "label": "TS: Limpar projeto individual",
      "type": "shell",
      "command": "npx tsc -b ${input:tsProject} --clean",
      "problemMatcher": []
    },
    {
      "label": "Backend: Iniciar",
      "type": "shell",
      "command": "bash -lc \"cd apps/api && node --env-file=.env --import tsx src/server.ts\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOTENV_CONFIG_PATH": "apps/api/.env"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Server listening at http://"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Backend: Desligar",
      "type": "shell",
      "command": "bash -lc 'set +e; pids=\"$(lsof -tiTCP:3333 -sTCP:LISTEN 2>/dev/null)\"; if [ -n \"$pids\" ]; then kill -TERM $pids 2>/dev/null; sleep 1; kill -KILL $pids 2>/dev/null; fi; pkill -TERM -f \"apps/api/src/server.ts|pnpm -C apps/api exec|node --env-file=.env --import tsx|tsx src/server.ts|apps/api/dist/.+server\" 2>/dev/null; sleep 1; pkill -KILL -f \"apps/api/src/server.ts|pnpm -C apps/api exec|node --env-file=.env --import tsx|tsx src/server.ts|apps/api/dist/.+server\" 2>/dev/null; true'",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Backend: Reiniciar",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Backend: Desligar",
        "Backend: Iniciar"
      ],
      "problemMatcher": []
    },
    {
      "label": "Frontend: Iniciar",
      "type": "shell",
      "command": "pnpm -C apps/web dev -- --host 0.0.0.0",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Frontend: Desligar",
      "type": "shell",
      "command": "bash -lc \"pids=$(lsof -tiTCP:5173 -sTCP:LISTEN 2>/dev/null); if [ -n \\\"$pids\\\" ]; then kill $pids; else pkill -f 'vite.*--host 0.0.0.0|pnpm -C apps/web dev' || true; fi\"",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Reiniciar",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Frontend: Desligar",
        "Frontend: Iniciar"
      ],
      "problemMatcher": []
    },
    {
      "label": "Core: Build",
      "type": "shell",
      "command": "pnpm -C packages/core build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "API: Build",
      "type": "shell",
      "command": "pnpm -C apps/api build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Build",
      "type": "shell",
      "command": "pnpm -C apps/web build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Root: Testes Unitarios",
      "type": "shell",
      "command": "pnpm test:unit",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Core: Testes",
      "type": "shell",
      "command": "pnpm -C packages/core vitest run",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "API: Testes",
      "type": "shell",
      "command": "pnpm -C apps/api vitest run",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Prisma: Gerar schema e client API",
      "type": "shell",
      "command": "npx prisma db pull --schema=apps/api/prisma/schema.prisma && npx prisma generate --schema=apps/api/prisma/schema.prisma",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Testes Unitarios",
      "type": "shell",
      "command": "pnpm -C apps/web test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "API: Reset runtime local",
      "type": "shell",
      "command": "bash -lc \"set -euo pipefail; cd '${workspaceFolder}'; echo '==> Encerrando processos locais da API'; pkill -f 'apps/api/src/server.ts' 2>/dev/null || true; pkill -f 'tsx src/index.ts' 2>/dev/null || true; pkill -f 'node --env-file=.env --import tsx src/server.ts' 2>/dev/null || true; echo '==> Limpando dist locais'; rm -rf apps/api/dist packages/core/dist apps/web/dist; echo '==> Removendo cópias empacotadas de @core-kit/api'; rm -rf node_modules/@core-kit/api 2>/dev/null || true; rm -rf node_modules/.pnpm/node_modules/@core-kit/api 2>/dev/null || true; echo '==> Instalando dependências'; pnpm install; echo '==> Gerando Prisma Client'; pnpm -C apps/api exec prisma generate --schema=prisma/schema.prisma; echo '==> Buildando core'; pnpm -C packages/core build; echo '==> Buildando api'; pnpm -C apps/api build; echo '==> Subindo API via source'; cd apps/api && node --env-file=.env --import tsx src/server.ts\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Server listening at http://"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
